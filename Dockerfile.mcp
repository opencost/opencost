FROM golang:1.21-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o mcp-server ./cmd/mcp-server

FROM alpine:latest
RUN apk --no-cache add ca-certificates
WORKDIR /root/
COPY --from=builder /app/mcp-server .
EXPOSE 8080
CMD ["./mcp-server"]

# ============================================================================

# File: scripts/build-mcp.sh
#!/bin/bash

echo "Building OpenCost MCP Server..."

# Build the binary
go build -o bin/mcp-server ./cmd/mcp-server

# Build Docker image
docker build -f Dockerfile.mcp -t opencost-mcp-server:latest .

echo "MCP Server built successfully!"